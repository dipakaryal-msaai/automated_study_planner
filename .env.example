# Database Configuration for Automated Study Planner

# For local development with SQLite (default)
# DATABASE_URL=sqlite:///data/study_planner.db

# For PostgreSQL (uncomment and configure for production/Render)
# DATABASE_URL=postgresql://username:password@localhost:5432/study_planner

# Note: Render managed Postgres provides DATABASE_URL automatically when attached
# You don't need to set it manually when deploying with a linked database

# Flask Secret Key (change in production)
# SECRET_KEY=your-secret-key-here
# FLASK_DEBUG=0
# HOST=127.0.0.1
# PORT=5000
# SESSION_COOKIE_SECURE=0
# REMEMBER_COOKIE_SECURE=0
# SESSION_COOKIE_SAMESITE=Lax
# PREFERRED_URL_SCHEME=http

# ── Admin Dashboard ──────────────────────────────────────────────────────────
# Comma-separated list of emails that can access /admin
# ADMIN_EMAILS=you@example.com,other@example.com

# ── Email (SMTP) Configuration ───────────────────────────────────────────────
# Required to enable daily study reminder emails for all users.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@gmail.com   # defaults to SMTP_USERNAME if omitted

# ── ntfy Push Notifications (optional) ──────────────────────────────────────
# NTFY_SERVER=https://ntfy.sh     # defaults to ntfy.sh if omitted
# NOTIFICATION_SCHEDULER_ENABLED=1
# NOTIFICATION_POLL_INTERVAL_SECONDS=60

# ── AI Study Insights (optional, local Ollama) ──────────────────────────────
# Enable the advisory AI dashboard panel for logged-in users
# AI_INSIGHTS_ENABLED=1
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_REQUEST_TIMEOUT_SECONDS=30
# OLLAMA_JSON_RETRY_ATTEMPTS=2
# OLLAMA_TEMPERATURE=0.2
